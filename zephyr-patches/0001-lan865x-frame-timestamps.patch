@@ -545,8 +734,18 @@ static int lan865x_port_send(const struct device *dev, struct net_pkt *pkt)
 	struct oa_tc6 *tc6 = ctx->tc6;
 	int ret;
 
+#ifdef LAN865X_PTP
+	bool want_ts = lan865x_is_ptp_frame(pkt) || net_pkt_is_tx_timestamping(pkt);
+#endif
+
 	k_sem_take(&ctx->tx_rx_sem, K_FOREVER);
+#ifdef LAN865X_PTP
+	tc6->want_ts_next = want_ts;
+#endif
 	ret = oa_tc6_send_chunks(tc6, pkt);
+#ifdef LAN865X_PTP
+	tc6->want_ts_next = false;
+#endif
 
 	/* Check if rca > 0 during half-duplex TX transmission */
 	if (tc6->rca > 0) {
@@ -560,10 +759,52 @@ static int lan865x_port_send(const struct device *dev, struct net_pkt *pkt)
 		return ret;
 	}
 
+#ifdef LAN865X_PTP
+	/* The frame leaves at this node's next PLCA opportunity: wait for its egress stamp. */
+	if (want_ts) {
+		pkt->timestamp.second = UINT64_MAX;
+		pkt->timestamp.nanosecond = UINT32_MAX;
+		for (int i = 0; i < 200; i++) {
+			uint32_t st = 0, hi = 0, lo = 0;
+
+			if (tc6->tx_ts_valid) {
+				pkt->timestamp.second = tc6->tx_ts >> 32;
+				pkt->timestamp.nanosecond = (uint32_t)tc6->tx_ts;
+				tc6->tx_ts_valid = false;
+				break;
+			}
+			k_sem_take(&ctx->tx_rx_sem, K_FOREVER);
+			oa_tc6_reg_read(tc6, OA_STATUS0, &st);
+			if (st & OA_STATUS0_TTSCAA) {
+				oa_tc6_reg_read(tc6, OA_TTSCAH, &hi);
+				oa_tc6_reg_read(tc6, OA_TTSCAL, &lo);
+				oa_tc6_reg_write(tc6, OA_STATUS0, OA_STATUS0_TTSCAA);
+				k_sem_give(&ctx->tx_rx_sem);
+				pkt->timestamp.second = hi;
+				pkt->timestamp.nanosecond = lo;
+				break;
+			}
+			k_sem_give(&ctx->tx_rx_sem);
+			k_usleep(100);
+		}
+		/* a late stamp or a capture overflow (STATUS1 21..26, masked) blocks every later capture */
+		k_sem_take(&ctx->tx_rx_sem, K_FOREVER);
+		oa_tc6_reg_write(tc6, OA_STATUS1, 0x3fu << 21);
+		oa_tc6_reg_write(tc6, OA_STATUS0, OA_STATUS0_TTSCAA);
+		k_sem_give(&ctx->tx_rx_sem);
+#if defined(CONFIG_NET_PKT_TIMESTAMP_THREAD)
+		net_if_add_tx_timestamp(pkt);
+#endif
+	}
+#endif
+
 	return 0;
 }
 
