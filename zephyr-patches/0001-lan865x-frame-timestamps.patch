diff --git a/drivers/ethernet/eth_lan865x.c b/drivers/ethernet/eth_lan865x.c
index 5a588914b..a33942d5d 100644
--- a/drivers/ethernet/eth_lan865x.c
+++ b/drivers/ethernet/eth_lan865x.c
@@ -410,6 +410,25 @@ static void lan865x_read_chunks(const struct device *dev)
 		return;
 	}
 
+	/* LOCAL PATCH (t1s-zone-node): strip a prepended ingress stamp (FTSS: seconds, ns, BE) */
+	if (tc6->pkt_ts && net_pkt_get_len(pkt) > 8) {
+		uint8_t b[8];
+		uint64_t ts = 0;
+
+		net_pkt_cursor_init(pkt);
+		net_pkt_read(pkt, b, sizeof(b));
+		for (int i = 0; i < 8; i++) {
+			ts = ts << 8 | b[i];
+		}
+		net_pkt_cursor_init(pkt);
+		net_pkt_pull(pkt, sizeof(b));
+		net_pkt_cursor_init(pkt);
+		if (oa_tc6_rx_ts_cb) {
+			oa_tc6_rx_ts_cb(pkt, ts);
+			net_pkt_cursor_init(pkt);
+		}
+	}
+
 	/* Feed buffer frame to IP stack */
 	ret = net_recv_data(ctx->iface, pkt);
 	if (ret < 0) {
@@ -435,6 +454,9 @@ static void lan865x_int_thread(const struct device *dev)
 				lan865x_default_config(dev, ctx->silicon_rev);
 				oa_tc6_reg_read(tc6, OA_CONFIG0, &val);
 				val |= OA_CONFIG0_SYNC | OA_CONFIG0_RFA_ZARFE;
+#ifdef LAN865X_FRAME_TIMESTAMPS /* LOCAL PATCH: only latches together with SYNC */
+				val |= OA_CONFIG0_FTSE | OA_CONFIG0_FTSS;
+#endif
 				oa_tc6_reg_write(tc6, OA_CONFIG0, val);
 				lan865x_mac_rxtx_control(dev, LAN865x_MAC_TXRX_ON);
 
