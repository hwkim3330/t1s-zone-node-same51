@@ -51,10 +51,166 @@ static void lan865x_iface_init(struct net_if *iface)
 	ctx->iface_initialized = true;
 }
 
+
+/*
+ * LOCAL PATCH (t1s-zone-node): the LAN8651's 1588 wall clock (TSU, 25 MHz, 40 ns ticks) as a
+ * Zephyr PTP clock, and frame stamps for gPTP. Built with LAN865X_FRAME_TIMESTAMPS + CONFIG_PTP_CLOCK.
+ */
+#if defined(LAN865X_FRAME_TIMESTAMPS) && defined(CONFIG_PTP_CLOCK)
+#define LAN865X_PTP 1
+#include <zephyr/drivers/ptp_clock.h>
+#include <zephyr/net/ptp_time.h>
+
+#define LAN865x_MAC_TISUBN MMS_REG(0x1, 0x06F)
+#define LAN865x_MAC_TSH    MMS_REG(0x1, 0x070)
+#define LAN865x_MAC_TSL    MMS_REG(0x1, 0x074)
+#define LAN865x_MAC_TN     MMS_REG(0x1, 0x075)
+#define LAN865x_MAC_TA     MMS_REG(0x1, 0x076)
+#define LAN865x_MAC_TI     MMS_REG(0x1, 0x077)
+
+struct lan865x_ptp {
+	const struct device *eth;
+	double ratio; /* accumulated rate_adjust, 1.0 = nominal 40 ns per tick */
+};
+static struct lan865x_ptp lan865x_ptp_0;
+
+static int lan865x_ptp_reg(const struct device *eth, bool wr, uint32_t reg, uint32_t *v)
+{
+	struct lan865x_data *ctx = eth->data;
+	int ret;
+
+	if (k_sem_take(&ctx->tx_rx_sem, K_MSEC(100)) != 0) {
+		return -EBUSY;
+	}
+	ret = wr ? oa_tc6_reg_write(ctx->tc6, reg, *v) : oa_tc6_reg_read(ctx->tc6, reg, v);
+	k_sem_give(&ctx->tx_rx_sem);
+	return ret;
+}
+
+static int lan865x_ptp_set(const struct device *dev, struct net_ptp_time *tm)
+{
+	struct lan865x_ptp *p = dev->data;
+	uint32_t hi = (uint32_t)(tm->second >> 32) & 0xffff, sl = (uint32_t)tm->second,
+		 ns = tm->nanosecond;
+
+	return lan865x_ptp_reg(p->eth, true, LAN865x_MAC_TSH, &hi) |
+	       lan865x_ptp_reg(p->eth, true, LAN865x_MAC_TN, &ns) |
+	       lan865x_ptp_reg(p->eth, true, LAN865x_MAC_TSL, &sl);
+}
+
+static int lan865x_ptp_get(const struct device *dev, struct net_ptp_time *tm)
+{
+	struct lan865x_ptp *p = dev->data;
+	uint32_t ns = 0, sl = 0, sl2 = 0;
+	/* TN first, then TSL (the order the TSU latches); re-read TSL across a second wrap */
+	int ret = lan865x_ptp_reg(p->eth, false, LAN865x_MAC_TN, &ns) |
+		  lan865x_ptp_reg(p->eth, false, LAN865x_MAC_TSL, &sl);
+
+	lan865x_ptp_reg(p->eth, false, LAN865x_MAC_TSL, &sl2);
+	if (sl2 != sl && ns < NSEC_PER_SEC / 2) {
+		sl = sl2;
+	}
+	tm->second = sl;
+	tm->nanosecond = ns;
+	return ret;
+}
+
+static int lan865x_ptp_adjust(const struct device *dev, int increment)
+{
+	struct lan865x_ptp *p = dev->data;
+
+	if (increment <= -(int)NSEC_PER_SEC || increment >= (int)NSEC_PER_SEC) {
+		return -EINVAL;
+	}
+	uint32_t v = (increment < 0 ? BIT(31) : 0) |
+		     ((uint32_t)(increment < 0 ? -increment : increment) & 0x3fffffff);
+
+	return lan865x_ptp_reg(p->eth, true, LAN865x_MAC_TA, &v);
+}
+
+static int lan865x_ptp_rate_adjust(const struct device *dev, double ratio)
+{
+	struct lan865x_ptp *p = dev->data;
+
+	if (ratio == 1.0) {
+		return 0;
+	}
+	double r = p->ratio * ratio;
+
+	if (r < 0.999 || r > 1.001) { /* +-1000 ppm */
+		return -EINVAL;
+	}
+	p->ratio = r;
+	/* increment = 40 ns x ratio in 2^-24 ns: TISUBN (low byte in 31:24, high 16 in 15:0) before TI */
+	uint64_t inc = (uint64_t)(40.0 * 16777216.0 * r + 0.5);
+	uint32_t ti = inc >> 24, sub = inc & 0xffffff;
+	uint32_t subv = (sub & 0xff) << 24 | ((sub >> 8) & 0xffff);
+
+	return lan865x_ptp_reg(p->eth, true, LAN865x_MAC_TISUBN, &subv) |
+	       lan865x_ptp_reg(p->eth, true, LAN865x_MAC_TI, &ti);
+}
+
+static const struct ptp_clock_driver_api lan865x_ptp_api = {
+	.set = lan865x_ptp_set,
+	.get = lan865x_ptp_get,
+	.adjust = lan865x_ptp_adjust,
+	.rate_adjust = lan865x_ptp_rate_adjust,
+};
+
+static int lan865x_ptp_init(const struct device *dev)
+{
+	struct lan865x_ptp *p = dev->data;
+
+	p->eth = DEVICE_DT_INST_GET(0);
+	p->ratio = 1.0;
+	return 0;
+}
+
+DEVICE_DEFINE(lan865x_ptp_clock_0, PTP_CLOCK_NAME, lan865x_ptp_init, NULL, &lan865x_ptp_0, NULL,
+	      POST_KERNEL, CONFIG_PTP_CLOCK_INIT_PRIORITY, &lan865x_ptp_api);
+
+static const struct device *lan865x_get_ptp_clock(const struct device *dev)
+{
+	ARG_UNUSED(dev);
+	return DEVICE_GET(lan865x_ptp_clock_0);
+}
+
+/* The TSU counts and the PHY's packet matcher stamps every frame at the SFD (out of reset it is
+ * off and matches gPTP Sync only). Written with the chip configuration after every reset. */
+static void lan865x_ptp_chip_setup(struct oa_tc6 *tc6)
+{
+	static const uint16_t mm[][2] = {{0x43, 0x00ff}, {0x44, 0xffff}, {0x45, 0},
+					 {0x53, 0x00ff}, {0x54, 0xffff}, {0x55, 0},
+					 {0x40, 2}, {0x50, 2}}; /* TXMCTL.TXME, RXMCTL.RXME */
+
+	oa_tc6_reg_write(tc6, LAN865x_MAC_TI, 40);
+	for (size_t i = 0; i < ARRAY_SIZE(mm); i++) {
+		oa_tc6_reg_write(tc6, MMS_REG(0x4, mm[i][0]), mm[i][1]);
+	}
+}
+
+static bool lan865x_is_ptp_frame(struct net_pkt *pkt)
+{
+	uint8_t h[14];
+
+	net_pkt_cursor_init(pkt);
+	if (net_pkt_read(pkt, h, sizeof(h))) {
+		net_pkt_cursor_init(pkt);
+		return false;
+	}
+	net_pkt_cursor_init(pkt);
+	return (h[12] << 8 | h[13]) == NET_ETH_PTYPE_PTP;
+}
+#endif /* LAN865X_FRAME_TIMESTAMPS && CONFIG_PTP_CLOCK */
+
 static enum ethernet_hw_caps lan865x_port_get_capabilities(const struct device *dev)
 {
 	ARG_UNUSED(dev);
-	return ETHERNET_LINK_10BASE_T | ETHERNET_PROMISC_MODE;
+	return ETHERNET_LINK_10BASE_T | ETHERNET_PROMISC_MODE
+#ifdef LAN865X_PTP
+	       | ETHERNET_PTP
+#endif
+		;
 }
 
