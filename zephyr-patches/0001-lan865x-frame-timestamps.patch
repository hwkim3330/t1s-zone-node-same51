 #define OA_DATA_HDR_SWO		      GENMASK(19, 16)
 #define OA_DATA_HDR_EV		      BIT(14)
 #define OA_DATA_HDR_EBO		      GENMASK(13, 8)
+#define OA_DATA_HDR_TSC		      GENMASK(7, 6) /* LOCAL PATCH: egress capture A/B/C */
