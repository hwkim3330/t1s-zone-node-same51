+
+	/* LOCAL PATCH (t1s-zone-node): frame timestamps */
+	/** the packet just read carries a prepended 64-bit ingress stamp */
+	bool pkt_ts;
+	/** ...and so does the frame that started in concat_buf */
+	bool concat_ts;
+	/** egress stamp of the last frame sent with TSC = A (seconds << 32 | ns), valid when set */
+	volatile uint64_t tx_ts;
+	volatile bool tx_ts_valid;
 };
 
+/*
+ * LOCAL PATCH (t1s-zone-node): frame timestamp hooks, set by the application.
+ * oa_tc6_tx_ts_want: asked for every frame sent; true = capture its egress time into TTSCA
+ *   (the driver reads it on the next status check into tx_ts / tx_ts_valid).
+ * oa_tc6_rx_ts_cb: called for every received frame that carried an ingress stamp, after the
+ *   stamp is stripped and before the frame goes up the stack. Driver context: keep it short.
+ */
+extern bool (*oa_tc6_tx_ts_want)(struct net_pkt *pkt);
+extern void (*oa_tc6_rx_ts_cb)(struct net_pkt *pkt, uint64_t ts);
