@@ -410,6 +566,33 @@ static void lan865x_read_chunks(const struct device *dev)
 		return;
 	}
 
+	/* LOCAL PATCH (t1s-zone-node): strip a prepended ingress stamp (FTSS: seconds, ns, BE) */
+	if (tc6->pkt_ts && net_pkt_get_len(pkt) > 8) {
+		uint8_t b[8];
+		uint64_t ts = 0;
+
+		net_pkt_cursor_init(pkt);
+		net_pkt_read(pkt, b, sizeof(b));
+		for (int i = 0; i < 8; i++) {
+			ts = ts << 8 | b[i];
+		}
+		net_pkt_cursor_init(pkt);
+		net_pkt_pull(pkt, sizeof(b));
+		net_pkt_cursor_init(pkt);
