/ {
	zephyr,user {
		/* RST and INT of slots 1..3 through the board's mikroBUS nexus nodes */
		rst-gpios = <&mikrobus_1 1 GPIO_ACTIVE_LOW>,
			    <&mikrobus_2 1 GPIO_ACTIVE_LOW>,
			    <&mikrobus_3 1 GPIO_ACTIVE_LOW>;
		int-gpios = <&mikrobus_1 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&mikrobus_2 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&mikrobus_3 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};
