mainmenu "T1S zone node"

config APP_PLCA_NODE_ID
	int "PLCA node id (0 = coordinator)"
	range 0 254
	default 1

config APP_PLCA_NODE_COUNT
	int "PLCA node count (used only by the coordinator)"
	range 1 255
	default 8

config APP_PLCA_TO_TIMER
	int "PLCA TO timer (bit times)"
	default 32

config APP_PLCA_BURST_COUNT
	int "PLCA max burst count"
	default 0

config APP_PLCA_BURST_TIMER
	int "PLCA burst timer"
	default 128

config APP_STATUS_PERIOD_S
	int "Seconds between status lines on the console (0 = off)"
	default 5

config APP_ZENOH
	bool "zenoh-pico client (t1s/sam<id>/hello, /cmd, /ack)"
	default y

config APP_ZENOH_LOCATOR
	string "zenohd to connect to (shell `zenoh <locator>` overrides, saved)"
	default "tcp/192.168.100.51:7448"
	depends on APP_ZENOH

config APP_PTP_MASTER
	string "Lock the LAN8651 clock to this sync answerer at boot (empty = only by hand)"
	default "192.168.100.65"
	help
	  The ESP gateway (`mode node` + `gw on`) answers the UDP 5007 exchange with hardware stamps.
	  The lock runs for ever: re-locked after a lost master, offset in t1s/sam<id>/hello.

source "Kconfig.zephyr"
